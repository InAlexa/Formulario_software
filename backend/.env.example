DJANGO_SECRET_KEY=cambia-esto-por-una-clave-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (MySQL) ---
DB_NAME=registro_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Proveedor de verificación de correo activo: "resend" o "supabase" ---
EMAIL_VERIFICATION_PROVIDER=resend
EMAIL_VERIFICATION_REDIRECT_URL=http://localhost:5173/verificado

# --- Resend (Settings -> API Keys en resend.com) ---
RESEND_API_KEY=re_tu_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Supabase (solo si EMAIL_VERIFICATION_PROVIDER=supabase) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-publishable-key